name: "vision-encoder"
platform: "tensorrt_plan"
max_batch_size: 0

input [
  {
    name: "images"
    data_type: TYPE_FP32
    dims: [ -1, 3, 1008, 1008 ]
  }
]

output [
  {
    name: "fpn_feat_0"
    data_type: TYPE_FP32
    dims: [ -1, 256, -1, -1 ]
  },
  {
    name: "fpn_feat_1"
    data_type: TYPE_FP32
    dims: [ -1, 256, -1, -1 ]
  },
  {
    name: "fpn_feat_2"
    data_type: TYPE_FP32
    dims: [ -1, 256, -1, -1 ]
  },
  {
    name: "fpn_pos_2"
    data_type: TYPE_FP32
    dims: [ -1, 256, 72, 72 ]
  }
]
